{
  "manifest_version": 3,
  "name": "ENEP-BERR",
  "version": "1.5",
  "description": "Limiteur de Shorts et Reels",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "src/plateformes/popup/popup.html"
  },
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "src/plateformes/options/options.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.instagram.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/plateformes/content-scripts/content-youtube.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/watch*"],
      "js": ["src/plateformes/content-scripts/content-youtube-notes.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["src/plateformes/content-scripts/content-instagram.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "enep-berr@extension.local"
    }
  }
}
